# Normalize line endings: store text as LF in the repo, check out native on Windows.
* text=auto eol=lf

# Explicit text types
*.js   text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.webmanifest text eol=lf

# Windows-only launcher keeps CRLF
*.bat  text eol=crlf

# Binary files
*.png  binary
*.ico  binary
